# Generated mobile split metrics and bundles
/build/

# Pinned DSH UI remains a local installation resource. Do not capture a newer
# desktop UI during installation or commit plugin inventories/compiled bundles.
/dsh-mobile/frontend/*
!/dsh-mobile/frontend/manifest.json
/dsh-mobile/.backup/
/claude-mobile/.backup/
**/outputs/
**/*-receipt.json
**/verification.json

